+            .OrderBy(file => file.path, StringComparer.Ordinal).ToArray();
+        var summary = new
+        {
+            unchanged = files.Count(file => file.status == "unchanged"),
+            missing = files.Count(file => file.status == "missing"),
+            modified = files.Count(file => file.status == "modified"),
+            unsafeCount = files.Count(file => file.status == "unsafe")
+        };
+        if (options.Json)
+        {
+            Console.WriteLine(JsonSerializer.Serialize(new
+            {
+                version = 1,
+                files,
+                summary = new Dictionary<string, int>
+                {
+                    ["unchanged"] = summary.unchanged, ["missing"] = summary.missing,
+                    ["modified"] = summary.modified, ["unsafe"] = summary.unsafeCount
+                }
+            }));
+        }
+        else
+        {
+            foreach (var file in files) Console.WriteLine($"{file.status.ToUpperInvariant()} {file.path}");
+            Console.WriteLine($"Summary: unchanged={summary.unchanged}, missing={summary.missing}, modified={summary.modified}, unsafe={summary.unsafeCount}.");
+        }
+        return summary.missing + summary.modified + summary.unsafeCount == 0 ? 0 : 1;
+    }

+    private static Tool ParseVerifyTools(string value)
+    {
+        if (string.Equals(value, "all", StringComparison.OrdinalIgnoreCase)) return Tool.Codex | Tool.Claude;
+        var tools = Tool.None;
+        foreach (var part in value.Split(','))
+        {
+            var item = part.Trim();
+            tools |= item.ToLowerInvariant() switch
+            {
+                "codex" => Tool.Codex,
+                "claude" => Tool.Claude,
+                _ => throw new ArgumentException($"Invalid verify-installed tool '{item}'. Use codex, claude, or all.")
+            };
+        }
+        return tools;
+    }
+
+    private void ValidateVerifyState()
+    {
+        var stateRoot = Path.GetFullPath(Path.GetDirectoryName(_statePath)!);
+        var statePath = Path.GetFullPath(_statePath);
+        var rootEntry = VerifyEntry(stateRoot);
+        if (rootEntry is not null && ((rootEntry.Attributes & FileAttributes.ReparsePoint) != 0 || rootEntry is not DirectoryInfo))
+            throw new InvalidOperationException($"State directory is unsafe: {stateRoot}.");
+        if (rootEntry is null) return;
+        var stateEntry = VerifyEntry(statePath);
+        if (stateEntry is null) return;
+        if ((stateEntry.Attributes & FileAttributes.ReparsePoint) != 0 || stateEntry is not FileInfo)
+            throw new InvalidOperationException($"State file is unsafe: {statePath}.");
+        StateDocument? state;
+        try { state = JsonSerializer.Deserialize<StateDocument>(File.ReadAllText(statePath)); }
+        catch (JsonException) { throw new InvalidOperationException($"State file is invalid JSON: {statePath}."); }
+        if (state is null || state.Version != 1 || state.Files is null ||
+            state.Files.Any(entry => !Path.IsPathFullyQualified(entry.Key) || entry.Value is null ||
+                entry.Value.Length != 64 || !entry.Value.All(Uri.IsHexDigit)))
+            throw new InvalidOperationException($"State file has an invalid version or shape: {statePath}.");
+    }

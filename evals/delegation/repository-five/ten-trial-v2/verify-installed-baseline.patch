+    private string VerifyFile(PlannedFile file)
+    {
+        var root = Path.GetFullPath(_home);
+        var destination = Path.GetFullPath(file.Destination);
+        var relative = Path.GetRelativePath(root, destination);
+        if (relative == ".." || relative.StartsWith(".." + Path.DirectorySeparatorChar, StringComparison.Ordinal) || Path.IsPathRooted(relative))
+            throw new InvalidOperationException($"Expected destination is outside the configured home: {destination}.");
+        var current = root;
+        var parts = relative.Split(Path.DirectorySeparatorChar);
+        for (var index = -1; index < parts.Length; index++)
+        {
+            if (index >= 0) current = Path.Combine(current, parts[index]);
+            var entry = VerifyEntry(current);
+            if (entry is null) return "missing";
+            if ((entry.Attributes & FileAttributes.ReparsePoint) != 0) return "unsafe";
+            if (index < parts.Length - 1 && entry is not DirectoryInfo) return "unsafe";
+            if (index == parts.Length - 1)
+            {
+                if (entry is not FileInfo) return "unsafe";
+                return File.ReadAllBytes(current).AsSpan().SequenceEqual(file.Content) ? "unchanged" : "modified";
+            }
+        }
+        throw new InvalidOperationException("Invalid expected destination.");
+    }
+
+    private static FileSystemInfo? VerifyEntry(string path) =>
+        Path.GetPathRoot(path) == path ? new DirectoryInfo(path) : GetEntry(path);
